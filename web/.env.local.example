# Sluice — local environment
# Copy to .env.local. Every variable here is OPTIONAL: without them the app still
# runs fully against Arc Testnet (streams, marketplace, treasury, cross-chain).
# They only unlock the Circle-hosted features.

# Circle developer API key — SERVER-SIDE ONLY, never prefix this NEXT_PUBLIC_.
# Read by the Circle Wallets routes (src/app/api/wallet/route.ts) and the Swap Kit
# CORS proxy (src/app/api/circle/[...path]/route.ts).
# Get one at https://console.circle.com/
CIRCLE_API_KEY=

# Circle App ID for user-controlled (MPC) wallets — powers /onboard.
# Console -> Programmable Wallets -> Configurator.
NEXT_PUBLIC_CIRCLE_APP_ID=

# Override the Sluice core contract address. Leave unset to use the address in
# src/lib/deployments.5042002.json, which is what the live deployment uses.
NEXT_PUBLIC_SLUICE_ADDRESS=

# --- Solana payouts (relayer only, NOT used by the web app) ---
# Base58 secret key of a devnet-funded keypair. Without it the relayer runs
# EVM-only and Arc->Solana burns are left pending rather than delivered.
# Fund with: solana airdrop 2 <pubkey> --url devnet
# SOLANA_PRIVATE_KEY=
